# --- Приложение ---
APP_NAME=Mind IT
APP_ENV=dev
DEBUG=true
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173"]
FRONTEND_URL=http://localhost:5173

# --- PostgreSQL ---
POSTGRES_HOST=localhost
# 5433 — host-порт контейнера (внутри compose backend ходит на postgres:5432)
POSTGRES_PORT=5433
POSTGRES_USER=mind_it
POSTGRES_PASSWORD=mind_it
POSTGRES_DB=mind_it

# --- Redis ---
# Если 6379 занят на хосте, задайте REDIS_PORT и тот же порт в REDIS_URL.
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380/0

# --- JWT / сессии ---
JWT_SECRET=dev-insecure-secret-change-me-please-32b
JWT_ALGORITHM=HS256
JWT_ISSUER=psy-it
ACCESS_TOKEN_TTL_MINUTES=45
REFRESH_TOKEN_TTL_DAYS=30
SESSION_IDLE_TIMEOUT_DAYS=7
EMAIL_CODE_TTL_MINUTES=15
OAUTH_STATE_TTL_MINUTES=10

# --- Комиссия ---
COMMISSION_FIXED_RUB=500

# --- Email (Mailhog) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@mind-it.local
SMTP_TLS=false

# --- OAuth: Yandex ---
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/yandex/callback

# --- OAuth: Google ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/google/callback

# --- OAuth: GitHub ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/github/callback
